{
    # 접근 로그를 켜지 않으며 upstream 오류에도 OAuth code·state가 기록되지 않게 한다.
    log default {
        exclude http.log.error
    }
}

http://monkeybot.lol {
    # 프록시 생존 확인이며 앱·DB 준비 상태 검사와 구분한다.
    handle /healthz {
        respond "ok\n" 200
    }
    handle {
        redir https://monkeybot.lol{uri} 308
    }
}

monkeybot.lol {
    # 앱 내부 API와 Prometheus 수집 경로는 프록시에만 열고 공개하지 않는다.
    @internal path /internal /internal/* /metrics /metrics/*
    handle @internal {
        respond 404
    }
    # Grafana는 하위 경로에서 로그인 후 대시보드만 제공한다.
    @grafana path /grafana /grafana/*
    handle @grafana {
        reverse_proxy grafana:3000 {
            transport http {
                dial_timeout 5s
                response_header_timeout 60s
            }
        }
    }
    handle {
        request_body {
            max_size 70MiB
        }
        import {$MSM2_CADDY_HANDLER:maintenance.caddy}
    }
}
