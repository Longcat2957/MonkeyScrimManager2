# /opt/monkeybot/.env에 복사할 Compose 경로·자원 설정이다.
# 실제 서비스 비밀 값은 /etc/monkeybot의 역할별 환경 파일에 보관한다.
COMPOSE_FILE=compose.yml
MSM2_ENV_DIR=/etc/monkeybot
MSM2_POSTGRES_VOLUME=monkeybot-postgres-data
MSM2_POSTGRES_PORT=10010
MSM2_HTTP_PUBLISH=80:80
MSM2_HTTPS_PUBLISH=443:443
MSM2_HTTP3_PUBLISH=443:443/udp
MSM2_LEGACY_DATA_NETWORK=deploy_data
MSM2_TUNNEL_NETWORK=monkeybot_tunnel

# compose.app.yml을 합치는 릴리스에서 CI의 공통 이미지를 입력한다.
# 앱 배포 이후에는 COMPOSE_FILE=compose.yml:compose.app.yml로 전환한다.
MSM2_APP_IMAGE=
