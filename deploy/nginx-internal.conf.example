# 실제 서비스의 server 블록에 포함한다. 내부 API는 인터넷에 공개하지 않는다.
location = /internal {
    return 404;
}

location ^~ /internal/ {
    return 404;
}

location = /metrics {
    return 404;
}

location ^~ /metrics/ {
    return 404;
}

# 웹 앱은 HOST=127.0.0.1로 실행하고 봇은 같은 호스트의 내부 주소로 호출한다.
# 파일 본문은 앱에서 64MiB로 검사하며 multipart 형식의 여유를 둔다.
client_max_body_size 70m;
client_body_timeout 60s;
# 업로드 본문을 프록시의 임시 파일로 남기지 않고 앱으로 전달한다.
proxy_request_buffering off;
proxy_http_version 1.1;
proxy_connect_timeout 5s;
proxy_send_timeout 60s;
proxy_read_timeout 60s;
proxy_set_header Host $host;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header Connection "";

location = /auth/discord/callback {
    # upstream 장애의 오류 로그도 callback의 code/state 쿼리를 보관하지 않게 한다.
    access_log off;
    error_log /dev/null;
    proxy_pass http://127.0.0.1:3000;
}

location / {
    proxy_pass http://127.0.0.1:3000;
}
