# /etc/monkeybot/web.env에 저장할 웹 전용 설정이다.
# Compose의 raw 형식이므로 값을 따옴표로 감싸거나 셸 식을 넣지 않는다.
# 기존 DB 접속 URL은 유지하고 운영 키를 서버에서 채운다.
DATABASE_URL=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Discord 개발자 포털의 Redirects에도 같은 주소를 등록한다.
DISCORD_REDIRECT_URI=https://monkeybot.lol/auth/discord/callback
DISCORD_BOT_TOKEN=

RIOT_API_KEY=
RIOT_ACCOUNT_REGION=asia
RIOT_PLATFORM=kr
RIOT_API_TIMEOUT_MS=10000

# 웹·봇에 같은 32자 이상 난수 키를 설정한다.
BOT_INTERNAL_TOKEN=
# 봇 상태 서버의 컨테이너 간 바인딩은 후속 배포 단계에서 연결한다.
BOT_STATUS_URL=http://bot:3101/status

# DB·ROFL 처리 제한은 앱의 기본값을 사용하며 필요한 항목만 추가한다.
