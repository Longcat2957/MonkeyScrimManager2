DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# 기본 명령 등록 대상이다. 운영 전역 등록은 register:commands --global로 명시한다.
DISCORD_TEST_GUILD_ID=

# 웹 내부 API와 같은 32자 이상의 키를 사용한다. 브라우저에 노출하지 않는다.
BOT_INTERNAL_TOKEN=
BOT_API_URL=http://127.0.0.1:3000
WEB_ORIGIN=http://localhost:5173

# 백오피스에서 읽는 127.0.0.1 전용 포트다. 비우면 상태 서버를 열지 않는다.
BOT_STATUS_PORT=
