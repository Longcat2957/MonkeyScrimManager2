{
    "name": "@msm2/bot",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node --env-file-if-exists=.env dist/index.js",
        "check": "tsc -p tsconfig.json --noEmit",
        "register:commands": "node --env-file-if-exists=.env --import tsx src/commands/register.ts",
        "test": "node --import tsx --import ./tests/network-guard.mjs --test tests/*.test.ts",
        "check:tests": "tsc --noEmit -p tests/tsconfig.json"
    },
    "dependencies": {
        "discord.js": "^14.27.0"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3"
    }
}
