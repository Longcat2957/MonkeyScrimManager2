# PostgreSQL 접속 주소. 실제 DB를 사용할 때만 필요하다.
# 예시: postgresql://msm2:password@127.0.0.1:5432/msm2
DATABASE_URL=

# PostgreSQL 17 이상. lock < statement < query 순서의 양수 밀리초다.
# query는 서버 transaction/idle-in-transaction 상한이며 Node 연결 점유는 추가 1초 후 종료한다.
DB_LOCK_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=30000

# 한 Node 프로세스의 ROFL 제한이다. 큐를 만들지 않고 초과 요청은 429와 Retry-After로 거절한다.
ROFL_MAX_CONCURRENT=2
# 비우면 min(2, 전역 동시성)이다. 값을 지정하면 전역 동시성 이하여야 한다.
ROFL_USER_CONCURRENT=
ROFL_USER_REQUEST_LIMIT=12
ROFL_RATE_WINDOW_MS=60000
# 본문은 실제 reader를 취소하고 파싱은 실제 worker 종료를 기다린다.
ROFL_BODY_TIMEOUT_MS=30000
ROFL_PARSE_TIMEOUT_MS=5000

# 64MiB ROFL 파일과 multipart 본문 여유를 허용하는 운영 adapter-node 요청 크기 제한이다.
BODY_SIZE_LIMIT=70M

# 운영 adapter-node는 로컬 프록시 뒤에서만 연다. Vite 개발 서버 설정과는 별개다.
HOST=127.0.0.1
PORT=3000
# 신뢰하는 로컬 nginx가 덮어쓰는 헤더다. 앱 포트를 외부에 공개하지 않는다.
PROTOCOL_HEADER=x-forwarded-proto
SHUTDOWN_TIMEOUT=25

# Discord OAuth와 서버 소속 검증. 토큰과 비밀키는 서버에서만 사용한다.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Discord 개발자 설정에 같은 callback 주소를 등록한다. 운영에서는 실제 HTTPS 주소로 바꾼다.
DISCORD_REDIRECT_URI=http://localhost:5173/auth/discord/callback
DISCORD_BOT_TOKEN=

# Riot API 키. 웹 서버에서만 읽는다.
RIOT_API_KEY=

# ACCOUNT-V1 지역: asia, americas, europe 중 하나다.
RIOT_ACCOUNT_REGION=asia

# 참가자 프로필과 랭크를 조회할 LoL 플랫폼이다.
RIOT_PLATFORM=kr

# 요청 제한 시간(밀리초)이다.
RIOT_API_TIMEOUT_MS=10000

# Discord 봇 상태 확인 주소(백오피스). 봇의 BOT_STATUS_PORT와 맞춘다. 비우면 설정 안 됨으로 표시한다.
# 예시: http://127.0.0.1:3101/status
BOT_STATUS_URL=

# 봇 내부 API 인증 키. apps/bot/.env의 같은 변수에 동일한 난수 값을 설정한다.
# 프록시에서 /internal/ 외부 접근을 차단하며 브라우저로 전달하지 않는다.
BOT_INTERNAL_TOKEN=
