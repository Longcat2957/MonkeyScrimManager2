# PostgreSQL 접속 주소. 실제 DB를 사용할 때만 필요하다.
# 예시: postgresql://msm2:password@127.0.0.1:5432/msm2
DATABASE_URL=

# Discord OAuth와 서버 소속 검증. 토큰과 비밀키는 서버에서만 사용한다.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Discord 개발자 설정에 같은 callback 주소를 등록한다.
DISCORD_REDIRECT_URI=http://localhost:5173/auth/discord/callback
DISCORD_BOT_TOKEN=

# Riot API key. Read only by the web server.
RIOT_API_KEY=

# ACCOUNT-V1 cluster: asia, americas, or europe.
RIOT_ACCOUNT_REGION=asia

# LoL platform for participant profiles and ranks.
RIOT_PLATFORM=kr

# Optional request timeout in milliseconds.
RIOT_API_TIMEOUT_MS=10000

# Discord 봇 상태 확인 주소(백오피스). 봇의 BOT_STATUS_PORT와 맞춘다. 비우면 설정 안 됨으로 표시한다.
# 예시: http://127.0.0.1:3101/status
BOT_STATUS_URL=

# 봇 내부 API 인증 키. apps/bot/.env의 같은 변수에 동일한 난수 값을 설정한다.
# 프록시에서 /internal/ 외부 접근을 차단하며 브라우저로 전달하지 않는다.
BOT_INTERNAL_TOKEN=
