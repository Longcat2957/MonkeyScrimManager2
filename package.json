{
  "name": "monkey-scrim-manager-2",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": "^22.17.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @msm2/web dev",
    "dev:bot": "pnpm --filter @msm2/bot dev",
    "build": "pnpm -r build",
    "build:bot": "pnpm --filter @msm2/bot build",
    "start": "pnpm --filter @msm2/web start",
    "start:bot": "pnpm --filter @msm2/bot start",
    "check": "pnpm check:branding && pnpm -r check",
    "db:generate": "pnpm --filter @msm2/web db:generate",
    "db:migrate": "pnpm --filter @msm2/web db:migrate",
    "rofl:inspect": "node --experimental-strip-types scripts/inspect_rofl.mts",
    "rofl:project": "node --experimental-strip-types scripts/project_rofl.mts",
    "rofl:research": "node --experimental-strip-types scripts/research_rofl.mts",
    "check:branding": "node scripts/check_branding.mjs"
  }
}
